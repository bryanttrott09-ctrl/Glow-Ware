function ThemeManager:SetLibrary(Library)
    ThemeManager.Library = Library
end

local function GetFolderPath(): false | string
    if not ThemeManager.Folder or ThemeManager.Folder == "" then
        return false
    end
    return string.format("%s/themes", ThemeManager.Folder)
end

local function GetThemePath(ThemeName: string): false | string
    local CurrentThemesPath = GetFolderPath()
    return if CurrentThemesPath == false then false else string.format("%s/%s.json", CurrentThemesPath, ThemeName)
end

local function GetDefaultThemePath(): false | string
    local CurrentThemesPath = GetFolderPath()
    return if CurrentThemesPath == false then false else string.format("%s/default.txt", CurrentThemesPath)
end

function ThemeManager:BuildFolderTree()
    local FolderPath = GetFolderPath()
    if not FolderPath then return false end

    local Parts = {}
    local Current = ""
    for Part in string.gmatch(FolderPath, "[^/]+") do
        Current = if Current == "" then Part else (Current .. "/" .. Part)
        table.insert(Parts, Current)
    end

    for _, Path in Parts do
        if not isfolder(Path) then
            makefolder(Path)
        end
    end

    return true
end

function ThemeManager:SetFolder(Folder: string)
    ThemeManager.Folder = Folder
    ThemeManager:BuildFolderTree()
end

function ThemeManager:ReloadCustomThemes()
    local SettingsPath = GetFolderPath()
    if not SettingsPath then return {} end

    local Success, Files = pcall(listfiles, SettingsPath)
    if not (Success and typeof(Files) == "table") then
        return {}
    end

    local FileNames = {}
    for _, FilePath in Files do
        local RawFileName = FilePath:match("(.+)%..+$")
        if not RawFileName then continue end

        local Position = RawFileName:gsub("\\", "/"):find("/[^/]*$")
        local FileName = Position and RawFileName:sub(Position + 1) or RawFileName
        if not FileName or FileName == "default" then continue end

        table.insert(FileNames, FileName)
    end

    return FileNames
end

function ThemeManager:GetCustomTheme(ThemeName: string)
    local ThemePath = GetThemePath(ThemeName)
    if not ThemePath or not isfile(ThemePath) then return nil end

    local SuccessRead, Content = pcall(readfile, ThemePath)
    if not SuccessRead then return nil end

    local SuccessDecode, Decoded = pcall(HttpService.JSONDecode, HttpService, Content)
    if not SuccessDecode or typeof(Decoded) ~= "table" then return nil end

    return Decoded
end

function ThemeManager:ApplyThemeData(ThemeData: any)
    if typeof(ThemeData) ~= "table" then return false end

    local Library = ThemeManager.Library
    local SchemeIndexes = { "FontColor", "MainColor", "AccentColor", "BackgroundColor", "OutlineColor" }

    for _, Index in SchemeIndexes do
        if ThemeData[Index] then
            local SuccessColor, Color = pcall(Color3.fromHex, ThemeData[Index])
            if SuccessColor then
                Library.Scheme[Index] = Color
                if Library.Options[Index] then
                    Library.Options[Index]:SetValueRGB(Color)
                end
            end
        end
    end

    Library:UpdateColorsUsingRegistry()
    return true
end

function ThemeManager:ApplyTheme(ThemeName: string)
    if not ThemeName or ThemeName == "" then return false end

    local CustomThemeData = ThemeManager:GetCustomTheme(ThemeName)
    local Data = CustomThemeData or ThemeManager.BuiltInThemes[ThemeName]

    if not Data then return false end

    local ThemeData = CustomThemeData or Data[2]
    return ThemeManager:ApplyThemeData(ThemeData)
end

function ThemeManager:SaveCustomTheme(ThemeName: string)
    if not ThemeName or ThemeName == "" or string.lower(ThemeName) == "default" then
        return false, "Invalid theme name"
    end

    local ThemePath = GetThemePath(ThemeName)
    if not ThemePath then return false, "Invalid path" end

    ThemeManager:BuildFolderTree()

    local Library = ThemeManager.Library
    local SchemeIndexes = { "FontColor", "MainColor", "AccentColor", "BackgroundColor", "OutlineColor" }
    local ThemeData = {}

    for _, SchemeIndex in SchemeIndexes do
        ThemeData[SchemeIndex] = Library.Options[SchemeIndex].Value:ToHex()
    end

    local SuccessEncode, EncodedData = pcall(HttpService.JSONEncode, HttpService, ThemeData)
    if not SuccessEncode then return false, "Failed to encode theme" end

    local SuccessWrite, ErrorMessage = pcall(writefile, ThemePath, EncodedData)
    if not SuccessWrite then return false, tostring(ErrorMessage) end

    return true
end

function ThemeManager:Delete(ThemeName: string)
    local ThemePath = GetThemePath(ThemeName)
    if not ThemePath or not isfile(ThemePath) then return false end

    local SuccessDelete = pcall(delfile, ThemePath)
    if not SuccessDelete then return false end

    if ThemeName == ThemeManager.DefaultThemeName then
        ThemeManager:DeleteDefaultTheme()
    end

    return true
end

function ThemeManager:GetDefaultTheme()
    ThemeManager:BuildFolderTree()

    local DefaultThemePath = GetDefaultThemePath()
    if not DefaultThemePath or not isfile(DefaultThemePath) then
        return "none", false
    end

    local SuccessRead, DefaultThemeName = pcall(readfile, DefaultThemePath)
    if not (SuccessRead and typeof(DefaultThemeName) == "string") then
        return "none", false
    end

    ThemeManager.DefaultThemeName = DefaultThemeName
    return DefaultThemeName, true
end

function ThemeManager:SaveDefault(ThemeName: string)
    ThemeManager:BuildFolderTree()

    local DefaultThemePath = GetDefaultThemePath()
    if not DefaultThemePath then return false end

    local SuccessWrite = pcall(writefile, DefaultThemePath, ThemeName)
    if not SuccessWrite then return false end

    ThemeManager.DefaultThemeName = ThemeName
    return true
end

function ThemeManager:LoadDefault()
    local ThemeName, Success = ThemeManager:GetDefaultTheme()
    if not Success then return end

    ThemeManager:ApplyTheme(ThemeName)
end

function ThemeManager:DeleteDefaultTheme()
    ThemeManager:BuildFolderTree()

    local DefaultThemePath = GetDefaultThemePath()
    if not DefaultThemePath or not isfile(DefaultThemePath) then return false end

    local SuccessDelete = pcall(delfile, DefaultThemePath)
    if not SuccessDelete then return false end

    ThemeManager.DefaultThemeName = nil
    return true
end

function ThemeManager:CreateThemeManager(Groupbox: any)
    assert(ThemeManager.Library, "Library is not set. Call ThemeManager:SetLibrary(Library) first.")

    local BuiltInThemesNames = {}
    for Name in ThemeManager.BuiltInThemes do
        table.insert(BuiltInThemesNames, Name)
    end

    table.sort(BuiltInThemesNames, function(A, B)
        return ThemeManager.BuiltInThemes[A][1] < ThemeManager.BuiltInThemes[B][1]
    end)

    local function CreateColorOption(Text, SchemeIndex)
        Groupbox:AddLabel(Text):AddColorPicker(SchemeIndex, {
            Default = ThemeManager.Library.Scheme[SchemeIndex],
            Title = Text,
            Callback = function(Value)
                ThemeManager.Library.Scheme[SchemeIndex] = Value
                ThemeManager.Library:UpdateColorsUsingRegistry()
            end
        })
    end

    CreateColorOption("Background Color", "BackgroundColor")
    CreateColorOption("Main Color", "MainColor")
    CreateColorOption("Accent Color", "AccentColor")
    CreateColorOption("Outline Color", "OutlineColor")
    CreateColorOption("Font Color", "FontColor")

    Groupbox:AddDivider()

    local CustomThemeList, CustomThemeName, ThemeList, DefaultThemeLabel

    local function RefreshList()
        CustomThemeList:SetValues(ThemeManager:ReloadCustomThemes())
        CustomThemeList:SetValue(nil)
    end

    local function RefreshDefaultThemeLabel()
        local DefaultThemeName = ThemeManager:GetDefaultTheme()
        DefaultThemeLabel:SetText(string.format("Default theme: %s", DefaultThemeName))
    end

    ThemeList = Groupbox:AddDropdown("ThemeManager_ThemeList", {
        Text = "Theme list",
        Values = BuiltInThemesNames,
        Default = 1,
        AllowNull = false
    })

    ThemeList:OnChanged(function()
        ThemeManager:ApplyTheme(ThemeList.Value)
    end)

    Groupbox:AddButton("Set as default", function()
        if ThemeList.Value then
            ThemeManager:SaveDefault(ThemeList.Value)
            ThemeManager.Library:Notify(string.format("Set default theme to %q", ThemeList.Value))
            RefreshDefaultThemeLabel()
        end
    end)

    Groupbox:AddDivider()

    CustomThemeName = Groupbox:AddInput("ThemeManager_CustomThemeName", {
        Text = "Custom theme name"
    })

    Groupbox:AddButton("Create theme", function()
        local Name = CustomThemeName.Value
        if not Name or Name == "" then
            return ThemeManager.Library:Notify("Theme name cannot be empty.")
        end

        local Success, ErrorMessage = ThemeManager:SaveCustomTheme(Name)
        if not Success then
            return ThemeManager.Library:Notify("Failed to save theme: " .. tostring(ErrorMessage))
        end

        ThemeManager.Library:Notify(string.format("Created theme %q", Name))
        RefreshList()
    end)

    CustomThemeList = Groupbox:AddDropdown("ThemeManager_CustomThemeList", {
        Text = "Custom themes",
        Values = ThemeManager:ReloadCustomThemes(),
        AllowNull = true
    })

    Groupbox:AddButton("Load theme", function()
        local Name = CustomThemeList.Value
        if not Name or Name == "" then
            return ThemeManager.Library:Notify("Please select a theme.")
        end

        ThemeManager:ApplyTheme(Name)
        ThemeManager.Library:Notify(string.format("Loaded theme %q", Name))
    end)

    Groupbox:AddButton("Overwrite theme", function()
        local Name = CustomThemeList.Value
        if not Name or Name == "" then
            return ThemeManager.Library:Notify("Please select a theme.")
        end

        ThemeManager:SaveCustomTheme(Name)
        ThemeManager.Library:Notify(string.format("Overwrote theme %q", Name))
    end)

    Groupbox:AddButton("Delete theme", function()
        local Name = CustomThemeList.Value
        if not Name or Name == "" then
            return ThemeManager.Library:Notify("Please select a theme.")
        end

        ThemeManager:Delete(Name)
        ThemeManager.Library:Notify(string.format("Deleted theme %q", Name))
        RefreshList()
        RefreshDefaultThemeLabel()
    end)

    Groupbox:AddButton("Refresh list", RefreshList)

    DefaultThemeLabel = Groupbox:AddLabel("Default theme: ...", true)

    ThemeManager:LoadDefault()
    ThemeManager.AppliedToTab = true
    RefreshDefaultThemeLabel()

    return Groupbox
end

function ThemeManager:ApplyToTab(Tab: any)
    local Groupbox = Tab:AddLeftGroupbox("Themes")
    return ThemeManager:CreateThemeManager(Groupbox)
end

function ThemeManager:ApplyToGroupbox(Groupbox: any)
    return ThemeManager:CreateThemeManager(Groupbox)
end


getgenv().ScytheAttackCooldown = 0.01
getgenv().ScytheDashCooldown = 0.001
getgenv().ScytheDashDuration = 0.1875

local Backups = {
    Scythe = {}
}

local function secureModify(tbl, key, newValue, backupTbl)
    if rawget(tbl, key) ~= nil then
        if backupTbl[tbl] == nil then backupTbl[tbl] = {} end
        if backupTbl[tbl][key] == nil then backupTbl[tbl][key] = rawget(tbl, key) end
        rawset(tbl, key, newValue)
    end
end

local function restoreFromBackup(backupTbl)
    for tbl, keys in pairs(backupTbl) do
        for key, origValue in pairs(keys) do
            pcall(function() rawset(tbl, key, origValue) end)
        end
    end
    table.clear(backupTbl)
end

local function UpdateScythe()
    pcall(function()
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" then
                if Toggles.ToggleScytheAtk and Toggles.ToggleScytheAtk.Value then
                    secureModify(v, "AttackCooldown", getgenv().ScytheAttackCooldown, Backups.Scythe)
                    secureModify(v, "_attack_cooldown", 0, Backups.Scythe)
                end

                if Toggles.ToggleScytheDashCD and Toggles.ToggleScytheDashCD.Value then
                    secureModify(v, "_dash_cooldown", 0, Backups.Scythe)
                    secureModify(v, "DashCooldown", getgenv().ScytheDashCooldown, Backups.Scythe)
                    if rawget(v, "Info") then
                        secureModify(v.Info, "DashCooldown", getgenv().ScytheDashCooldown, Backups.Scythe)
                    end
                end

                if Toggles.ToggleScytheDashDur and Toggles.ToggleScytheDashDur.Value then
                    secureModify(v, "DashDuration", getgenv().ScytheDashDuration, Backups.Scythe)
                    if rawget(v, "Info") then
                        secureModify(v.Info, "DashDuration", getgenv().ScytheDashDuration, Backups.Scythe)
                    end
                end
            end
        end
    end)
end

ModificationsBox:AddToggle('ToggleScytheAtk', {Text = 'Enable Melee Cooldown', Default = false, Callback = function(state)
    if not state then 
        restoreFromBackup(Backups.Scythe) 
    else 
        task.wait(0.1) 
        UpdateScythe() 
    end
end})


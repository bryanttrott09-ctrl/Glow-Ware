table.insert(connections, RunService.RenderStepped:Connect(function(dt)
    if Config.SilentAimToggle and Config.SilentAimShowFOV then
        silentFOVContainer.Visible = true
        local diameter = Config.SilentAimFOVSize * 2
        silentFOVContainer.Size = UDim2.new(0, diameter, 0, diameter)

        if silentFOVCfg.SpinOn then
            silentFOVStrokeGrad.Rotation = (silentFOVStrokeGrad.Rotation + (silentFOVCfg.SpinSpd * 60 * dt)) % 360
        end
        if silentFOVCfg.FilledAnimated then
            silentFOVFillGrad.Rotation = (silentFOVFillGrad.Rotation + (silentFOVCfg.FilledSpeed * 60 * dt)) % 360
        end
    else
        silentFOVContainer.Visible = false
    end

    if Config.AimbotToggle and Config.AimbotShowFOV then
        aimbotFOVContainer.Visible = true
        local diameter = Config.AimbotFOVSize * 2
        aimbotFOVContainer.Size = UDim2.new(0, diameter, 0, diameter)

        if aimbotFOVCfg.SpinOn then
            aimbotFOVStrokeGrad.Rotation = (aimbotFOVStrokeGrad.Rotation + (aimbotFOVCfg.SpinSpd * 60 * dt)) % 360
        end
        if aimbotFOVCfg.FilledAnimated then
            aimbotFOVFillGrad.Rotation = (aimbotFOVFillGrad.Rotation + (aimbotFOVCfg.FilledSpeed * 60 * dt)) % 360
        end
    else
        aimbotFOVContainer.Visible = false
    end
end))

local X = {}
X.services = {
    rep = game:GetService("ReplicatedStorage"),
    plr = game:GetService("Players"),
    uis = game:GetService("UserInputService")
}

pcall(function()
    X.mod = require(X.services.rep.Modules.Utility)
    X.original = X.mod.Raycast
end)

X.cam = workspace.CurrentCamera
X.me = X.services.plr.LocalPlayer

local function isSilentAimVisible(targetPart, character)
    local origin = X.cam.CFrame.Position
    local direction = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {X.me.Character, character}
    
    local result = workspace:Raycast(origin, direction, raycastParams)
    return result == nil
end

local function getSilentAimTargetBone(character)
    if Config.SilentAimClosestPart then
        local closestPart = nil
        local shortestDist = math.huge
        local mousePos = Vector2.new(X.cam.ViewportSize.X / 2, X.cam.ViewportSize.Y / 2)

        for _, partName in ipairs({"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "LeftUpperLeg", "RightUpperLeg", "LeftUpperArm", "RightUpperArm"}) do
            local part = character:FindFirstChild(partName)
            if part then
                local screenPos, onScreen = X.cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPart = partName
                    end
                end
            end
        end
        return closestPart or Config.SilentAimPart
    end
    return Config.SilentAimPart
end

if X.mod and X.original then
    X.mod.Raycast = function(...)
        local args = {...}
        
        if not Config.SilentAimToggle or not X.services.uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then 
            return X.original(...) 
        end
        
        if math.random(1, 100) > Config.SilentAimHitChance then
            return X.original(...)
        end

        local cx = X.cam.ViewportSize.X / 2
        local cy = X.cam.ViewportSize.Y / 2
        local winner, record = nil, Config.SilentAimFOVSize
        local pool = {}

        for _, v in workspace:GetChildren() do
            if v:FindFirstChildOfClass("Humanoid") then
                pool[#pool + 1] = v
            end
            if v.Name == "HurtEffect" then
                for _, c in v:GetChildren() do
                    if c.ClassName ~= "Highlight" then
                        pool[#pool + 1] = c
                    end
                end
            end
        end

        for _, v in pool do
            if v == X.me.Character then continue end
            
            local targetPlr = X.services.plr:GetPlayerFromCharacter(v)
            if Config.SilentAimTeamCheck and targetPlr and targetPlr.Team == X.me.Team then 
                continue 
            end
            
            local hrp = v:FindFirstChild("HumanoidRootPart")
            if not hrp or (X.me.Character and X.me.Character:FindFirstChild("HumanoidRootPart") and (hrp.Position - X.me.Character.HumanoidRootPart.Position).Magnitude > Config.SilentAimMaxDistance) then
                continue
            end

            local targetBoneName = getSilentAimTargetBone(v)
            if not v:FindFirstChild(targetBoneName) then continue end
            
            if Config.SilentAimWallCheck and not isSilentAimVisible(v[targetBoneName], v) then
                continue
            end

            local p, vis = X.cam:WorldToViewportPoint(v[targetBoneName].Position)
            if not vis then continue end

            local d = ((Vector2.new(cx, cy)) - Vector2.new(p.X, p.Y)).Magnitude
            if d < record then
                winner, record = v, d
            end
        end

        if winner then
            local chosenBone = getSilentAimTargetBone(winner)
            if winner:FindFirstChild(chosenBone) then
                args[3] = winner[chosenBone].Position
            end
        end
        
        return X.original(table.unpack(args))
    end
end

local function isValidTarget(player)
	if player == LocalPlayer then return false end
	if not player.Character then return false end
	local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return false end
	
	if Config.AimbotTeamCheck and player.Team == LocalPlayer.Team then return false end
	local root = player.Character:FindFirstChild("HumanoidRootPart")
	local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if root and localRoot then
		if (root.Position - localRoot.Position).Magnitude > Config.AimbotMaxDistance then return false end
	else
		return false
	end
	return true
end

local function getTargetPart(character)
	if Config.AimbotClosestPart then
		local closestPart = nil
		local shortestDistance = math.huge
		local mousePos = Vector2.new(Mouse.X, Mouse.Y)
		
		for _, part in pairs(character:GetChildren()) do
			if part:IsA("BasePart") then
				local screenPos, onScreen = Camera:WorldToScreenPoint(part.Position)
				if onScreen then
					local dist = (mousePos - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
					if dist < shortestDistance then
						shortestDistance = dist
						closestPart = part
					end
				end
			end
		end
		return closestPart or character:FindFirstChild(Config.AimbotPart)
	else
		return character:FindFirstChild(Config.AimbotPart)
	end
end

local function isVisible(targetPlayer)
	local character = targetPlayer.Character
	if not character then return false end
	local targetPart = getTargetPart(character)
	if not targetPart then return false end
	
	if not Config.AimbotWallCheck then return true end
	
	local origin = Camera.CFrame.Position
	local direction = (targetPart.Position - origin).Unit * 1000
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
	rayParams.IgnoreWater = true
	
	local result = workspace:Raycast(origin, direction, rayParams)
	if result and result.Instance then
		if not character:IsAncestorOf(result.Instance) then return false end
	end
	return true
end

local function getClosestTarget()
	local closestPlayer = nil
	local shortestDistance = Config.AimbotFOVSize or 150
	local mousePos = Vector2.new(Mouse.X, Mouse.Y)
	
	if Config.AimbotClosestPlayer then
		shortestDistance = math.huge
	end
	
	for _, player in pairs(Players:GetPlayers()) do
		if isValidTarget(player) then
			local character = player.Character
			local targetPart = getTargetPart(character)
			if targetPart and isVisible(player) then
				local screenPoint = Camera:WorldToScreenPoint(targetPart.Position)
				local distance = (mousePos - Vector2.new(screenPoint.X, screenPoint.Y)).Magnitude
				
				if distance < shortestDistance then
					closestPlayer = player
					shortestDistance = distance
				end
			end
		end
	end
	
	if closestPlayer and closestPlayer.Character then
		return getTargetPart(closestPlayer.Character)
	end
	return nil
end

table.insert(connections, RunService.RenderStepped:Connect(function()
	local aimbotBindActive = Options.AimbotKeybind and Options.AimbotKeybind:GetState() or true
	if not Config.AimbotToggle or not aimbotBindActive then return end
	
	local targetPart = getClosestTarget()
	if targetPart then
		local targetPosition, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
		
		if onScreen and targetPosition.Z > 0 then
			local mousePos = Vector2.new(Mouse.X, Mouse.Y)
			local aimPos = Vector2.new(targetPosition.X, targetPosition.Y)
			local moveDelta = (aimPos - mousePos) * Config.AimbotSensitivity
			
			if mousemoverel then
				mousemoverel(moveDelta.X, moveDelta.Y)
			else
				local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
				Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, math.clamp(Config.AimbotSensitivity * 0.1, 0.01, 1))
			end
		end
	end
end))

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

if not game:IsLoaded() then
    pcall(function()
        game.Loaded:Wait()
    end)
end

local retries = 0
while not LocalPlayer and retries < 20 do
    task.wait(0.5)
    LocalPlayer = Players.LocalPlayer
    retries = retries + 1
end

if not LocalPlayer then return end

local ModificationsBox
pcall(function()
    if Tabs and Tabs.Aimbot then
        ModificationsBox = Tabs.Aimbot:AddRightGroupbox('Modifications')
    end
end)

getgenv().CombatMods = getgenv().CombatMods or {
    RapidFire = false,
    NoSpread = false,
    NoRecoil = false,
    MaxAccuracy = false,
    RapidAttack = false,
    GunModule = nil,
    MeleeModule = nil,
    OriginalGunStartShooting = nil,
    OriginalMeleeStartShooting = nil,
    OriginalGetSpread = nil,
    OriginalRecoil = nil,
}

local CombatMods = getgenv().CombatMods
local Camera = Workspace.CurrentCamera or Workspace:WaitForChild("Camera", 5)

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Camera = Workspace.CurrentCamera
end)

local function safeClosure(func)
    if typeof(newcclosure) == "function" then
        return newcclosure(func)
    end
    return func
end

pcall(function()
    local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts", 10)
    local Modules = PlayerScripts and PlayerScripts:WaitForChild("Modules", 5)
    local ItemTypes = Modules and Modules:WaitForChild("ItemTypes", 5)
    local GunPath = ItemTypes and ItemTypes:WaitForChild("Gun", 5)
    
    if not GunPath then return end
    
    local success, GunModule = pcall(function()
        return require(GunPath)
    end)
    
    if success and typeof(GunModule) == "table" then
        CombatMods.GunModule = GunModule
        
        if GunModule.StartShooting and not CombatMods.OriginalGunStartShooting then
            CombatMods.OriginalGunStartShooting = GunModule.StartShooting
            
            GunModule.StartShooting = safeClosure(function(self, p26, p27)
                if not self or not self.Info then 
                    return CombatMods.OriginalGunStartShooting(self, p26, p27)
                end
                
                local oldShootCooldown
                local oldSpread, oldMinSpread, oldMaxSpread
                
                if CombatMods.RapidFire then
                    oldShootCooldown = self.Info.ShootCooldown
                    self.Info.ShootCooldown = 0
                end
                
                if CombatMods.NoSpread or CombatMods.MaxAccuracy then
                    if self.Info.Spread then oldSpread = self.Info.Spread; self.Info.Spread = 0 end
                    if self.Info.MinSpread then oldMinSpread = self.Info.MinSpread; self.Info.MinSpread = 0 end
                    if self.Info.MaxSpread then oldMaxSpread = self.Info.MaxSpread; self.Info.MaxSpread = 0 end
                    
                    if self.Info.SpreadStates then
                        for state, val in pairs(self.Info.SpreadStates) do
                            self.Info.SpreadStates[state] = 0
                        end
                    end
                    
                    if typeof(p26) == "table" and Camera then
                        p26.Direction = Camera.CFrame.LookVector
                        p26.SpreadDirection = Camera.CFrame.LookVector
                        p26.OriginCFrame = Camera.CFrame
                    end
                end
                
                local result = { CombatMods.OriginalGunStartShooting(self, p26, p27) }
                
                if CombatMods.RapidFire and oldShootCooldown then
                    self.Info.ShootCooldown = oldShootCooldown
                end
                
                if CombatMods.NoSpread or CombatMods.MaxAccuracy then
                    if oldSpread then self.Info.Spread = oldSpread end
                    if oldMinSpread then self.Info.MinSpread = oldMinSpread end
                    if oldMaxSpread then self.Info.MaxSpread = oldMaxSpread end
                end
                
                return unpack(result)
            end)
        end
        
        if GunModule._Recoil and not CombatMods.OriginalRecoil then
            CombatMods.OriginalRecoil = GunModule._Recoil
            
            GunModule._Recoil = safeClosure(function(self, multiplier)
                if CombatMods.NoRecoil then
                    return
                end
                return CombatMods.OriginalRecoil(self, multiplier)
            end)
        end
    end
end)

pcall(function()
    if not hookmetamethod then return end
    
    local Remotes = RS:WaitForChild("Remotes", 5)
    local Replication = Remotes and Remotes:WaitForChild("Replication", 5)
    local Fighter = Replication and Replication:WaitForChild("Fighter", 5)
    local UseItem = Fighter and Fighter:WaitForChild("UseItem", 5)
    
    if UseItem and UseItem:IsA("RemoteEvent") then
        local oldNamecall
        local zeroKey = utf8.char(0)
        
        pcall(function()
            oldNamecall = hookmetamethod(game, "__namecall", safeClosure(function(self, ...)
                local method = getnamecallmethod()
                
                if self == UseItem and (method == "FireServer" or method == "fireServer") then
                    if CombatMods.NoSpread or CombatMods.MaxAccuracy then
                        local args = {...}
                        for i = 1, #args do
                            local arg = args[i]
                            if typeof(arg) == "table" then
                                for innerKey, inner in pairs(arg) do
                                    if typeof(inner) == "table" and rawget(inner, zeroKey) ~= nil then
                                        inner[zeroKey] = CFrame.new()
                                    end
                                end
                            end
                        end
                        return oldNamecall(self, unpack(args))
                    end
                end
                return oldNamecall(self, ...)
            end))
        end)
    end
end)

pcall(function()
    local Modules = RS:WaitForChild("Modules", 5)
    local UtilityPath = Modules and Modules:WaitForChild("GameplayUtility", 5)
    
    if not UtilityPath then return end
    
    local success, GameplayUtility = pcall(function()
        return require(UtilityPath)
    end)
    
    if success and typeof(GameplayUtility) == "table" and GameplayUtility.GetSpread then
        CombatMods.GameplayUtility = GameplayUtility
        if not CombatMods.OriginalGetSpread then
            CombatMods.OriginalGetSpread = GameplayUtility.GetSpread
            
            GameplayUtility.GetSpread = safeClosure(function(...)
                if CombatMods.NoSpread or CombatMods.MaxAccuracy then
                    return CFrame.new()
                end
                return CombatMods.OriginalGetSpread(...)
            end)
        end
    end
end)

pcall(function()
    local PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts", 10)
    local Modules = PlayerScripts and PlayerScripts:WaitForChild("Modules", 5)
    local ItemTypes = Modules and Modules:WaitForChild("ItemTypes", 5)
    local MeleePath = ItemTypes and ItemTypes:WaitForChild("Melee", 5)
    
    if not MeleePath then return end
    
    local success, MeleeModule = pcall(function()
        return require(MeleePath)
    end)
    
    if success and typeof(MeleeModule) == "table" then
        CombatMods.MeleeModule = MeleeModule
        
        if MeleeModule.StartShooting and not CombatMods.OriginalMeleeStartShooting then
            CombatMods.OriginalMeleeStartShooting = MeleeModule.StartShooting
            
            MeleeModule.StartShooting = safeClosure(function(self, p26, p27)
                if not self or not self.Info then 
                    return CombatMods.OriginalMeleeStartShooting(self, p26, p27)
                end
                
                local oldAttackCooldown
                if CombatMods.RapidAttack then
                    oldAttackCooldown = self.Info.AttackCooldown
                    self.Info.AttackCooldown = 0
                end
                
                local result = { CombatMods.OriginalMeleeStartShooting(self, p26, p27) }
                
                if CombatMods.RapidAttack and oldAttackCooldown then
                    self.Info.AttackCooldown = oldAttackCooldown
                end
                
                return unpack(result)
            end)
        end
    end
end)


function ThemeManager:SetLibrary(Library)
    ThemeManager.Library = Library
end

function ThemeManager:SetFolder(Folder: string)
    ThemeManager.Folder = Folder
    if not isfolder(Folder) then
        makefolder(Folder)
    end
    if not isfolder(Folder .. "/themes") then
        makefolder(Folder .. "/themes")
    end
end

function ThemeManager:ApplyTheme(ThemeName: string)
    local CustomTheme = ThemeManager:GetCustomTheme(ThemeName)
    local Theme = CustomTheme or ThemeManager.BuiltInThemes[ThemeName]

    if not Theme then return end

    for Field, Hex in Theme do
        if ThemeManager.Library[Field] then
            ThemeManager.Library[Field] = Color3.fromHex(Hex)
        end
    end

    ThemeManager.Library:UpdateColors()
end

function ThemeManager:GetCustomTheme(ThemeName: string)
    local Path = string.format("%s/themes/%s.json", ThemeManager.Folder, ThemeName)
    if not isfile(Path) then return nil end

    local Success, Content = pcall(readfile, Path)
    if not Success then return nil end

    local DecodedSuccess, Decoded = pcall(HttpService.JSONDecode, HttpService, Content)
    if not DecodedSuccess then return nil end

    return Decoded
end

function ThemeManager:SaveCustomTheme(ThemeName: string)
    if ThemeName:gsub(" ", "") == "" then
        return ThemeManager.Library:Notify("Theme name cannot be empty.")
    end

    local Theme = {}
    for _, Field in { "FontColor", "MainColor", "AccentColor", "BackgroundColor", "OutlineColor" } do
        Theme[Field] = ThemeManager.Library[Field]:ToHex()
    end

    local Path = string.format("%s/themes/%s.json", ThemeManager.Folder, ThemeName)
    local Success, Encoded = pcall(HttpService.JSONEncode, HttpService, Theme)
    if not Success then
        return ThemeManager.Library:Notify("Failed to encode theme JSON.")
    end

    writefile(Path, Encoded)
    ThemeManager.Library:Notify(string.format("Saved custom theme %q", ThemeName))
end

function ThemeManager:DeleteCustomTheme(ThemeName: string)
    local Path = string.format("%s/themes/%s.json", ThemeManager.Folder, ThemeName)
    if isfile(Path) then
        delfile(Path)
        ThemeManager.Library:Notify(string.format("Deleted theme %q", ThemeName))
    end
end

function ThemeManager:GetCustomThemes()
    if not isfolder(ThemeManager.Folder .. "/themes") then return {} end

    local Files = listfiles(ThemeManager.Folder .. "/themes")
    local Themes = {}

    for _, FilePath in Files do
        local Name = FilePath:match("([^/]+)%.json$") or FilePath:match("([^\\]+)%.json$")
        if Name then
            table.insert(Themes, Name)
        end
    end

    return Themes
end

function ThemeManager:ApplyToTab(Tab: any)
    assert(ThemeManager.Library, "Library is not set. Call ThemeManager:SetLibrary(Library) first.")

    local Groupbox = Tab:AddLeftGroupbox("Theme Manager")

    -- Built-in Themes
    local BuiltInList = {}
    for Name in ThemeManager.BuiltInThemes do
        table.insert(BuiltInList, Name)
    end
    table.sort(BuiltInList)

    local ThemeDropdown = Groupbox:AddDropdown("ThemeManager_ThemeList", {
        Text = "Theme",
        Values = BuiltInList,
        Default = ThemeManager.DefaultThemeName or BuiltInList[1]
    })

    ThemeDropdown:OnChanged(function(Value)
        ThemeManager:ApplyTheme(Value)
    end)

    -- Custom Themes
    Groupbox:AddDivider()

    local CustomThemeInput = Groupbox:AddInput("ThemeManager_CustomThemeName", {
        Text = "Custom theme name"
    })

    Groupbox:AddButton("Save custom theme", function()
        ThemeManager:SaveCustomTheme(CustomThemeInput.Value)
        ThemeManager:RefreshCustomThemeList()
    end)

    local CustomThemeDropdown = Groupbox:AddDropdown("ThemeManager_CustomThemeList", {
        Text = "Custom themes",
        Values = ThemeManager:GetCustomThemes(),
        AllowNull = true
    })

    function ThemeManager:RefreshCustomThemeList()
        CustomThemeDropdown:SetValues(ThemeManager:GetCustomThemes())
        CustomThemeDropdown:SetValue(nil)
    end

    Groupbox:AddButton("Load custom theme", function()
        if CustomThemeDropdown.Value then
            ThemeManager:ApplyTheme(CustomThemeDropdown.Value)
        end
    end)

    Groupbox:AddButton("Delete custom theme", function()
        if CustomThemeDropdown.Value then
            ThemeManager:DeleteCustomTheme(CustomThemeDropdown.Value)
            ThemeManager:RefreshCustomThemeList()
        end
    end)

    Groupbox:AddButton("Refresh list", function()
        ThemeManager:RefreshCustomThemeList()
    end)

    -- Theme Color Pickers
    Groupbox:AddDivider()

    for _, Field in { "FontColor", "MainColor", "AccentColor", "BackgroundColor", "OutlineColor" } do
        Groupbox:AddLabel(Field):AddColorPicker("ThemeManager_" .. Field, {
            Default = ThemeManager.Library[Field],
            Title = Field,
            Callback = function(Value)
                ThemeManager.Library[Field] = Value
                ThemeManager.Library:UpdateColors()
            end
        })
    end

    ThemeManager.AppliedToTab = true
end

return ThemeManager

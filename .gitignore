local firstPerson = viewModels and viewModels:WaitForChild("FirstPerson", 5)

local function cleanMuzzle(muzzle)
    if not muzzle or not muzzle:IsA("Instance") then return end
    
    local spot = muzzle:FindFirstChildOfClass("SpotLight")
    if spot then pcall(function() spot:Destroy() end) end
    
    for _, child in ipairs(muzzle:GetChildren()) do
        if child:IsA("ParticleEmitter") then
            pcall(function() child:Destroy() end)
        end
    end
end

local function nomuzzleflash()
    if not firstPerson then return end
    for _, model in ipairs(firstPerson:GetChildren()) do
        local itemVisual = model:FindFirstChild("ItemVisual")
        local body = itemVisual and itemVisual:FindFirstChild("Body")
        local bodyPrimary = body and body:FindFirstChild("BodyPrimary")
        local muzzle = bodyPrimary and bodyPrimary:FindFirstChild("_muzzle")
        if muzzle then
            cleanMuzzle(muzzle)
        end
    end
end


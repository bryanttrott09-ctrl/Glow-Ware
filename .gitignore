local Group = Tabs.Misc:AddLeftGroupbox('Spoofing')

local function RestoreOriginalAppearance()
    task.spawn(function()
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            local appSuccess, appearance = pcall(function()
                return Players:GetCharacterAppearanceAsync(OriginalData.UserId)
            end)

            if appSuccess and appearance then
                for _, v in ipairs(LocalPlayer.Character:GetChildren()) do
                    if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
                        v:Destroy()
                    end
                end

                for _, v in ipairs(appearance:GetChildren()) do
                    if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
                        v.Parent = LocalPlayer.Character
                    elseif v:IsA("Accessory") and hum then
                        hum:AddAccessory(v)
                    end
                end

                local parent = LocalPlayer.Character.Parent
                if parent then
                    LocalPlayer.Character.Parent = nil
                    LocalPlayer.Character.Parent = parent
                end
            end
        end
    end)
end

local function ApplyProfileSpoof()
    task.spawn(function()
        local targetUserId = tonumber(Settings.victim)
        if not targetUserId then return end

        local targetPlayer = (Settings.helper ~= "" and Players:FindFirstChild(Settings.helper)) or LocalPlayer
        if not targetPlayer then return end

        if Settings.levelEnabled then
            targetPlayer:SetAttribute("Level", tonumber(Settings.level) or 0)
        end
        if Settings.streakEnabled then
            targetPlayer:SetAttribute("StatisticDuelsWinStreak", tonumber(Settings.streak) or 0)
        end
        
        local customStats = targetPlayer:FindFirstChild("CustomLeaderstats")
        if customStats then
            if Settings.levelEnabled and customStats:FindFirstChild("Level") then
                customStats.Level.Value = tonumber(Settings.level) or 0
            end
            if Settings.streakEnabled and customStats:FindFirstChild("Win Streak") then
                customStats["Win Streak"].Value = tonumber(Settings.streak) or 0
            end
        end

        if Settings.eloEnabled and tonumber(Settings.elo) and tonumber(Settings.elo) > 0 then
            targetPlayer:SetAttribute("DisplayELO", tonumber(Settings.elo))
        end

        if not Settings.victimEnabled or not targetPlayer.Character then return end

        local appSuccess, appearance = pcall(function()
            return Players:GetCharacterAppearanceAsync(targetUserId)
        end)

        if not appSuccess or not appearance then return end

        for _, v in ipairs(targetPlayer.Character:GetChildren()) do
            if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
                v:Destroy()
            end
        end

        for _, v in ipairs(appearance:GetChildren()) do
            if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
                v.Parent = targetPlayer.Character
            elseif v:IsA("Accessory") then
                local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum:AddAccessory(v) end
            end
        end

        local parent = targetPlayer.Character.Parent
        if parent then
            targetPlayer.Character.Parent = nil
            targetPlayer.Character.Parent = parent
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid")
    if Settings.victimEnabled then
        task.wait(0.5)
        ApplyProfileSpoof()
    end
end)


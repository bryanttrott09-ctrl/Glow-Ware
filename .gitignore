pcall(function()
    local Players = game:GetService("Players")  
    local UserInputService = game:GetService("UserInputService")  
    local RunService = game:GetService("RunService")  
    local Workspace = game:GetService("Workspace")  
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local VirtualInputManager = game:GetService("VirtualInputManager")

    local localPlayer = Players.LocalPlayer  
    local camera = Workspace.CurrentCamera  

    local wow = nil
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    if modules then
        pcall(function()
            if modules:FindFirstChild("Utility") then
                wow = require(modules.Utility)
            end
        end)
    end

    local isActive = false  
    local connection = nil

    local autoHealth = false
    local autoAmmo = false
    local autoRespawn = false
    local boosterConnection = nil
    local bounceTime = 0
    
    local boosterCache = {}

    localPlayer.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then return end
        
        humanoid.Died:Connect(function()
            if not autoRespawn then return end
            pcall(function()
                while autoRespawn do
                    local char = localPlayer.Character
                    if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                        break
                    end
                    if keypress and keyrelease then
                        keypress(0x20)
                        task.wait(0.1)
                        keyrelease(0x20)
                    end
                    task.wait(0.1)
                end
            end)
        end)
    end)

    local function boosterLoop(dt)
        if not autoAmmo and not autoHealth then 
            for obj, original in pairs(boosterCache) do
                if obj and obj.Parent then
                    obj.Anchored = original.Anchored
                    obj.Transparency = original.Transparency
                    for child, state in pairs(original.Children) do
                        if child and child.Parent then
                            if child:IsA("BasePart") or child:IsA("UnionOperation") or child:IsA("MeshPart") then
                                child.Transparency = state.Transparency
                            elseif child:IsA("BillboardGui") or child:IsA("SurfaceGui") or child:IsA("ParticleEmitter") or child:IsA("SelectionBox") then
                                child.Enabled = state.Enabled
                            end
                        end
                    end
                end
            end
            table.clear(boosterCache)
            return 
        end

        local character = localPlayer.Character
        if not character then return end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        bounceTime = bounceTime + dt * 8
        local bounce = math.sin(bounceTime) * 4

        for _, obj in pairs(Workspace:GetChildren()) do
            if obj.Name == "_drop" and obj:IsA("BasePart") then
                local isAmmo = obj:FindFirstChild("Ammo")
                local isHealth = obj:FindFirstChild("Health")

                if (autoAmmo and isAmmo) or (autoHealth and isHealth) then
                    if not boosterCache[obj] then
                        local childStates = {}
                        for _, child in pairs(obj:GetDescendants()) do
                            if child:IsA("BasePart") or child:IsA("UnionOperation") or child:IsA("MeshPart") then
                                childStates[child] = { Transparency = child.Transparency }
                            elseif child:IsA("BillboardGui") or child:IsA("SurfaceGui") or child:IsA("ParticleEmitter") or child:IsA("SelectionBox") then
                                childStates[child] = { Enabled = child.Enabled }
                            end
                        end
                        boosterCache[obj] = {
                            Anchored = obj.Anchored,
                            Transparency = obj.Transparency,
                            Children = childStates
                        }
                    end

                    obj.Anchored = true
                    obj.CFrame = CFrame.new(hrp.Position + Vector3.new(0, bounce, 0))
                    obj.Transparency = 1
                    
                    for child, _ in pairs(boosterCache[obj].Children) do
                        if child:IsA("BasePart") or child:IsA("UnionOperation") or child:IsA("MeshPart") then
                            child.Transparency = 1
                        elseif child:IsA("BillboardGui") or child:IsA("SurfaceGui") or child:IsA("ParticleEmitter") or child:IsA("SelectionBox") then
                            child.Enabled = false
                        end
                    end
                end
            end
        end
    end


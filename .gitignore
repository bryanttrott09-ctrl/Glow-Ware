    local v555 = Tabs.Aimbot:AddRightGroupbox('Extras')

    v555:AddToggle('handcaps', {
        Text = 'Enable Handicaps',
        Default = _G.Features.Handicaps.Enabled,
        Callback = function(val)
            _G.Features.Handicaps.Enabled = val
            updHandicaps()
        end
    })

    v555:AddToggle("AntiTrip", {
        Text = "Anti Subspace Tripmine",
        Default = false,
        Callback = function(val)
            if tripConnection then 
                tripConnection:Disconnect() 
                tripConnection = nil 
            end
            
            if val then
                tripConnection = RunService.Heartbeat:Connect(runAntiTrip)
            end
        end
    })
else
    warn("[GlowWare]: Aimbot tab framework missing or failed to initialize.")
end


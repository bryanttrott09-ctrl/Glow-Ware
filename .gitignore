local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Terrain = Workspace.Terrain

local function getOpt(name, fallback)
    if Options and Options[name] and Options[name].Value ~= nil then
        return Options[name].Value
    end
    return fallback
end

local function getTog(name, fallback)
    if Toggles and Toggles[name] and Toggles[name].Value ~= nil then
        return Toggles[name].Value
    end
    return fallback
end

local function muzzlepos()
    local viewModels = Workspace:FindFirstChild("ViewModels")
    if not viewModels then return nil end
    local firstPerson = viewModels:FindFirstChild("FirstPerson")
    if not firstPerson then return nil end
    local playerName = LocalPlayer.Name
    for _, model in ipairs(firstPerson:GetChildren()) do
        if model:IsA("Model") and model.Name:find("^" .. playerName) then
            local iv = model:FindFirstChild("ItemVisual")
            if iv then
                local body = iv:FindFirstChild("Body")
                if body then
                    local bp = body:FindFirstChild("BodyPrimary")
                    if bp then
                        local muzzle = bp:FindFirstChild("_muzzle")
                        if muzzle and muzzle:IsA("Attachment") then
                            return muzzle.WorldPosition
                        end
                    end
                end
            end
        end
    end
    if typeof(getgenv().findShotMuzzlePosition) == "function" then
        return getgenv().findShotMuzzlePosition()
    end
    return nil
end

local function getTracerDrawEnd(tr, age)
    local speed = getOpt("TracerLerpSpeed", 0)
    if speed <= 0 then
        return tr.EndPos
    end
    local drawTime = math.max(speed * 0.25, 0.001)
    local progress = math.clamp(age / drawTime, 0, 1)
    return tr.StartPos:Lerp(tr.EndPos, progress)
end

local function makeLineTracer(pos3, endPos)
    local size = getOpt("TracerSize", 1)
    local outlineThickness = getOpt("TracerOutlineThickness", 1.5)
    
    local wireframe = Instance.new("WireframeHandleAdornment")
    wireframe.Thickness = 2 * size
    wireframe.Color3 = getOpt("TracerColor", Color3.fromRGB(255, 255, 255))
    wireframe.AlwaysOnTop = true
    wireframe.ZIndex = 10
    wireframe.Adornee = Terrain
    wireframe.Parent = Terrain

    local outlineWireframe = nil
    if getTog("TracerOutline", false) then
        outlineWireframe = Instance.new("WireframeHandleAdornment")
        outlineWireframe.Thickness = (2 * size) + outlineThickness
        outlineWireframe.Color3 = getOpt("TracerOutlineColor", Color3.fromRGB(0, 0, 0))
        outlineWireframe.AlwaysOnTop = true
        outlineWireframe.ZIndex = 9
        outlineWireframe.Adornee = Terrain
        outlineWireframe.Parent = Terrain
    end
    
    table.insert(tracers, {
        IsLine           = true,
        Wireframe        = wireframe,
        OutlineWireframe = outlineWireframe,
        StartPos         = pos3,
        EndPos           = endPos,
        Lifetime         = getOpt("TracerDuration", 1),
        FadeTime         = getOpt("TracerFade", 0.5),
        CreatedTime      = tick(),
    })
end

local function makeBeamTracer(pos3, endPos)
    local a0 = Instance.new("Attachment")
    a0.Parent = Terrain
    local a1 = Instance.new("Attachment")
    a1.Parent = Terrain

    local style = getOpt("TracerStyle", "Beam")
    local size = getOpt("TracerSize", 1)
    local outlineThickness = getOpt("TracerOutlineThickness", 1.5)
    local tracerColor = getOpt("TracerColor", Color3.fromRGB(255, 255, 255))

    local beam          = Instance.new("Beam")
    beam.Attachment0    = a0
    beam.Attachment1    = a1
    beam.Color          = ColorSequence.new(tracerColor)
    local baseW         = style == "Laser" and 0.02 or 0.15
    beam.Width0         = baseW * size
    beam.Width1         = baseW * size
    beam.Transparency   = NumberSequence.new(0)
    beam.FaceCamera     = true
    
    beam.LightEmission  = 0.8  
    beam.LightInfluence = 0.2  
    beam.ZOffset        = 3

    local tex = textureAssets[style]
    if tex and tex ~= "" then
        beam.Texture       = tex
        beam.TextureLength = 4
        beam.TextureSpeed  = 1
    else
        beam.Texture       = "" 
        beam.TextureLength = 1
        beam.TextureSpeed  = 0
    end
    beam.Parent = Terrain

    local outlineBeam = nil
    if getTog("TracerOutline", false) then
        local outlineColor = getOpt("TracerOutlineColor", Color3.fromRGB(0, 0, 0))
        outlineBeam                = Instance.new("Beam")
        outlineBeam.Attachment0    = a0
        outlineBeam.Attachment1    = a1
        outlineBeam.Color          = ColorSequence.new(outlineColor)
        local addedWidth           = outlineThickness * 0.03 
        outlineBeam.Width0         = (baseW * size) + addedWidth
        outlineBeam.Width1         = (baseW * size) + addedWidth
        outlineBeam.Transparency   = NumberSequence.new(0)
        outlineBeam.FaceCamera     = true
        
        outlineBeam.LightEmission  = 0.8   
        outlineBeam.LightInfluence = 0.2   
        
        outlineBeam.Texture        = ""
        outlineBeam.TextureLength  = 1
        outlineBeam.TextureSpeed   = 0
        outlineBeam.ZOffset        = 1
        outlineBeam.Parent         = Terrain
    end

    a0.WorldPosition = pos3
    a1.WorldPosition = endPos

    table.insert(tracers, {
        IsLine      = false,
        Beam        = beam,
        OutlineBeam = outlineBeam,
        Attachment0 = a0,
        Attachment1 = a1,
        StartPos    = pos3,
        EndPos      = endPos,
        Lifetime    = getOpt("TracerDuration", 1),
        FadeTime    = getOpt("TracerFade", 0.5),
        CreatedTime = tick(),
    })
end

local function destroyTracer(t)
    if not t then return end
    pcall(function()
        if t.IsLine then
            if t.Wireframe then t.Wireframe:Destroy() end
            if t.OutlineWireframe then t.OutlineWireframe:Destroy() end
        else
            if t.Beam        then t.Beam:Destroy()        end
            if t.OutlineBeam then t.OutlineBeam:Destroy() end
            if t.Attachment0 then t.Attachment0:Destroy() end
            if t.Attachment1 then t.Attachment1:Destroy() end
        end
    end)
end

getgenv().CreateBulletTracer = function(pos3, endPos)
    if getgenv().DISABLE_TRACERS or not pos3 or not endPos then return end

    local kx = math.floor(pos3.X * 5 + 0.5)
    local ky = math.floor(pos3.Y * 5 + 0.5)
    local kz = math.floor(pos3.Z * 5 + 0.5)
    local ex = math.floor(endPos.X * 5 + 0.5)
    local ey = math.floor(endPos.Y * 5 + 0.5)
    local ez = math.floor(endPos.Z * 5 + 0.5)
    local posKey = string.format("%d_%d_%d_%d_%d_%d", kx, ky, kz, ex, ey, ez)

    local now = tick()
    local last = lastTracerCreations[posKey]
    if last and (now - last) < DEDUPE_INTERVAL then return end
    lastTracerCreations[posKey] = now

    local style = getOpt("TracerStyle", "Line")
    if style == "Line" then
        makeLineTracer(pos3, endPos)
    else
        makeBeamTracer(pos3, endPos)
    end
end

local frameCount       = 0
local DEDUPE_PRUNE_INT = 120

local function updtracers()
    local totalTracers = #tracers
    if totalTracers == 0 then return end 

    frameCount = frameCount + 1
    local now   = tick()

    if frameCount % DEDUPE_PRUNE_INT == 0 then
        for k, t in pairs(lastTracerCreations) do
            if (now - t) > DEDUPE_EXPIRY then
                lastTracerCreations[k] = nil
            end
        end
    end

    for i = totalTracers, 1, -1 do
        local tr  = tracers[i]
        if tr then
            local age = now - tr.CreatedTime

            if age >= tr.Lifetime then
                destroyTracer(tr)
                table.remove(tracers, i)
            else
                local fadeAlpha
                local fadeStart = tr.Lifetime - tr.FadeTime
                if age >= fadeStart then
                    fadeAlpha = 1 - math.clamp((age - fadeStart) / math.max(tr.FadeTime, 0.001), 0, 1)
                else
                    fadeAlpha = 1
                end

                local drawEnd = getTracerDrawEnd(tr, age)

                pcall(function()
                    if tr.IsLine then
                        if tr.Wireframe and tr.Wireframe.Parent then
                            tr.Wireframe:Clear()
                            tr.Wireframe.Transparency = 1 - fadeAlpha
                            tr.Wireframe:AddLine(tr.StartPos, drawEnd)
                        end
                        if tr.OutlineWireframe and tr.OutlineWireframe.Parent then
                            tr.OutlineWireframe:Clear()
                            tr.OutlineWireframe.Transparency = 1 - fadeAlpha
                            tr.OutlineWireframe:AddLine(tr.StartPos, drawEnd)
                        end
                    else
                        if tr.Attachment0 and tr.Attachment0.Parent then
                            tr.Attachment0.WorldPosition = tr.StartPos
                        end
                        if tr.Attachment1 and tr.Attachment1.Parent then
                            tr.Attachment1.WorldPosition = drawEnd
                        end
                        if tr.Beam and tr.Beam.Parent then
                            tr.Beam.Transparency = NumberSequence.new(1 - fadeAlpha)
                        end
                        if tr.OutlineBeam and tr.OutlineBeam.Parent then
                            tr.OutlineBeam.Transparency = NumberSequence.new(1 - fadeAlpha)
                        end
                    end
                end)
            end
        end
    end
end

local function hookTracerEffect()
    if tracerEffectHooked then return end
    pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        if not ps then return end
        local modules = ps:FindFirstChild("Modules")
        if not modules then return end
        local tracerModule = modules:FindFirstChild("TracerEffect")
        if not tracerModule then return end

        local TracerEffect = require(tracerModule)
        local origPlay     = TracerEffect.Play

        TracerEffect.Play = function(self, tracerData, config, extraData)
            pcall(function()
                if getTog("TracerEnabled", false) and tracerData and tracerData.IsLocal and tracerData.RaycastResults then
                    local mPos = muzzlepos()
                    if mPos then
                        for _, hit in ipairs(tracerData.RaycastResults) do
                            if hit and hit.Position then
                                getgenv().CreateBulletTracer(mPos, hit.Position)
                            end
                        end
                    end
                end
            end)
            return origPlay(self, tracerData, config, extraData)
        end

        tracerEffectHooked = true
    end)
end

local function startTracers()
    if getgenv().DISABLE_TRACERS then
        if Toggles and Toggles.TracerEnabled then Toggles.TracerEnabled:SetValue(false) end
        return
    end

    hookTracerEffect()

    if not tracerconn then
        tracerconn = RunService.RenderStepped:Connect(updtracers)
    end
end

local function stoptracers()
    if tracerconn then
        tracerconn:Disconnect()
        tracerconn = nil
    end
    for _, tr in ipairs(tracers) do
        destroyTracer(tr)
    end
    tracers = {}
end


local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

_G.EquippedData = _G.EquippedData or {}
for weapon in pairs(SkinLists) do
    if not _G.EquippedData[weapon] then
        _G.EquippedData[weapon] = {Skin = "Default", Wrap = "None"}
    end
end

local function deepCopy(original)
    if type(original) ~= "table" then return original end
    local copy = {}
    for k, v in pairs(original) do
        if type(v) == "table" then
            copy[k] = deepCopy(v)
        else
            copy[k] = v
        end
    end
    return copy
end

pcall(function()
    local modulesFolder = ReplicatedStorage:WaitForChild("Modules", 10)
    if not modulesFolder then return end

    local function safeRequire(childName)
        local child = modulesFolder:FindFirstChild(childName)
        if child then
            local ok, res = pcall(require, child)
            if ok then return res end
        end
        return nil
    end

    local CosmeticLibrary = safeRequire("CosmeticLibrary")
    local ReplicatedClass = safeRequire("ReplicatedClass")
    local ClientViewModel

    local playerScripts = player:WaitForChild("PlayerScripts", 10)
    if playerScripts then
        local Modules = playerScripts:FindFirstChild("Modules")
        if Modules then
            local crc = Modules:FindFirstChild("ClientReplicatedClasses")
            local cf = crc and crc:FindFirstChild("ClientFighter")
            local ci = cf and cf:FindFirstChild("ClientItem")
            if ci and ci:FindFirstChild("ClientViewModel") then
                pcall(function() ClientViewModel = require(ci.ClientViewModel) end)
            end
        end
    end

    if not CosmeticLibrary or not ClientViewModel or not ReplicatedClass then
        return
    end

    local function getCosmeticData(name, cType, existingDefault)
        if not CosmeticLibrary or type(CosmeticLibrary.Cosmetics) ~= "table" then return nil end
        local base = CosmeticLibrary.Cosmetics[name]
        if not base then return nil end
        
        local ok, data = pcall(function()
            local cloned = existingDefault and deepCopy(existingDefault) or {}
            local sourceData = deepCopy(base)
            
            for k, v in pairs(sourceData) do
                cloned[k] = v
            end
            
            cloned.Name = name
            cloned.Type = cType
            return cloned
        end)
        return ok and data or nil
    end

    local function applySkinToReplicatedData(replicatedData, weaponName)
        if not replicatedData or not getgenv().SkinChangerEnabled then return end
        if not _G.EquippedData[weaponName] then return end

        local selectedSkin = _G.EquippedData[weaponName].Skin
        if not selectedSkin or selectedSkin == "Default" then return end

        local ok1, dataKey = pcall(function() return ReplicatedClass:ToEnum("Data") end)
        local ok2, skinKey = pcall(function() return ReplicatedClass:ToEnum("Skin") end)
        local ok3, nameKey = pcall(function() return ReplicatedClass:ToEnum("Name") end)

        if not (ok1 and ok2 and ok3 and dataKey and skinKey and nameKey) then return end

        replicatedData[dataKey] = replicatedData[dataKey] or {}
        local existingSkinData = replicatedData[dataKey][skinKey]

        local cosData = getCosmeticData(selectedSkin, "Skin", existingSkinData)
        if cosData then
            replicatedData[dataKey][skinKey] = cosData
            replicatedData[dataKey][nameKey] = selectedSkin
        end
    end

    if not getgenv()._AnihaStableHooksInstalled then
        getgenv()._AnihaStableHooksInstalled = true

        local origGetWrap = ClientViewModel.GetWrap
        local origNew = ClientViewModel.new
        local origUpdateSkin = ClientViewModel._UpdateSkin

        ClientViewModel.GetWrap = function(self, ...)
            if self and getgenv().WrapChangerEnabled then
                local wrapRes
                pcall(function()
                    local weaponName = self.ClientItem and self.ClientItem.Name
                    if weaponName and _G.EquippedData[weaponName] then
                        local wrapName = _G.EquippedData[weaponName].Wrap
                        if wrapName and wrapName ~= "None" then
                            wrapRes = getCosmeticData(wrapName, "Wrap")
                        end
                    end
                end)
                if wrapRes then return wrapRes end
            end
            if type(origGetWrap) == "function" then
                return origGetWrap(self, ...)
            end
            return nil
        end

        ClientViewModel._UpdateSkin = function(self, ...)
            if self and self.ClientItem and getgenv().SkinChangerEnabled then
                pcall(function()
                    local weaponName = self.ClientItem.Name
                    if weaponName and self.ReplicatedData then
                        applySkinToReplicatedData(self.ReplicatedData, weaponName)
                    end
                end)
            end
            if type(origUpdateSkin) == "function" then
                return origUpdateSkin(self, ...)
            end
        end

        ClientViewModel.new = function(replicatedData, clientItem, ...)
            if replicatedData and clientItem and getgenv().SkinChangerEnabled then
                pcall(function()
                    local weaponName = clientItem.Name
                    if weaponName then
                        local cf = rawget(clientItem, "ClientFighter")
                        if cf and cf.Player == player then
                            applySkinToReplicatedData(replicatedData, weaponName)
                        end
                    end
                end)
            end

            if type(origNew) == "function" then
                return origNew(replicatedData, clientItem, ...)
            end
            return nil
        end
    end
end)

local sortedWeapons = {}
for weapon in pairs(SkinLists) do table.insert(sortedWeapons, weapon) end
table.sort(sortedWeapons)

local selectedWeapon = sortedWeapons[1]

UnlockallGroupBox:AddDropdown("WeaponSelect", {
    Values = sortedWeapons,
    Default = 1,
    Multi = false,
    Text = "Select Weapon",
    Searchable = true,
    Callback = function(Value)
        selectedWeapon = Value
        pcall(function()
            local opts = getgenv().Options or (Library and Library.Options)
            if opts then
                if opts.SkinSelect then
                    opts.SkinSelect:SetValues(SkinLists[selectedWeapon] or {"Default"})
                    opts.SkinSelect:SetValue(_G.EquippedData[selectedWeapon].Skin or "Default")
                end
                if opts.WrapSelect then
                    opts.WrapSelect:SetValue(_G.EquippedData[selectedWeapon].Wrap or "None")
                end
            end
        end)
    end
})

UnlockallGroupBox:AddToggle("EnableSkins", {
    Text = "Enable Skin Changer",
    Default = false,
    Tooltip = "Applies your selected skin as soon as you equip the weapon",
    Callback = function(Value)
        getgenv().SkinChangerEnabled = Value
    end
})

UnlockallGroupBox:AddDropdown("SkinSelect", {
    Values = SkinLists[selectedWeapon] or {"Default"},
    Default = 1,
    Multi = false,
    Text = "Skin",
    Searchable = true,
    Callback = function(Value)
        if selectedWeapon and Value and _G.EquippedData[selectedWeapon] then
            _G.EquippedData[selectedWeapon].Skin = Value
        end
    end
})

UnlockallGroupBox:AddToggle("EnableWraps", {
    Text = "Enable Wrap Changer",
    Default = false,
    Tooltip = "Applies your selected wrap as soon as you equip the weapon",
    Callback = function(Value)
        getgenv().WrapChangerEnabled = Value
    end
})

UnlockallGroupBox:AddDropdown("WrapSelect", {
    Values = WrapList,
    Default = 1,
    Multi = false,
    Text = "Wrap",
    Searchable = true,
    Callback = function(Value)
        if selectedWeapon and Value and _G.EquippedData[selectedWeapon] then
            _G.EquippedData[selectedWeapon].Wrap = Value
        end
    end
})

UnlockallGroupBox:AddButton({
    Text = "Reset Weapon to Default",
    Func = function()
        pcall(function()
            local opts = getgenv().Options or (Library and Library.Options)
            if opts then
                if opts.SkinSelect then opts.SkinSelect:SetValue("Default") end
                if opts.WrapSelect then opts.WrapSelect:SetValue("None") end
            end
            if Library and Library.Notify then
                Library:Notify("Reset " .. tostring(selectedWeapon) .. " cosmetics to default.", 3)
            end
        end)
    end
})

